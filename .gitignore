# --- data -------------------------------------------------------------
# Raw and processed datasets are large. Download them instead of committing.
# NCSRD-DS-5GDDoS : https://zenodo.org/records/13900057
# Data4Cyber      : https://zenodo.org/records/19965384
data/**
!data/**/
!data/**/.gitkeep

# Large capture / dataset files, wherever they end up
*.pcapng
*.pcap
*.jsonl.gz
*.npz
*.parquet

# --- generated outputs ------------------------------------------------
# Experiment results ARE tracked: they are small, and the group needs the
# tables and plots without re-running anything. Trained models and any bulky
# intermediates are not (see the *.pkl / *.npz rules).
results/**
!results/**/
!results/**/.gitkeep
!results/**/*.csv
!results/**/*.json
!results/**/*.md
!results/**/*.png
experiments/**/outputs/
outputs/
*.pkl
*.joblib

# --- python -----------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version

# --- editors / os -----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
